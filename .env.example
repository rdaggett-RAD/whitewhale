# ============================================
# White Whale — Environment Variables
# Copy to .env and fill in all values
# In production, set these in Railway
# ============================================

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whitewhale

# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic (Claude) — used for signal classification + draft generation
ANTHROPIC_API_KEY=sk-ant-...

# Apollo — used for job posting signals, exec change signals, contact enrichment
APOLLO_API_KEY=

# NewsAPI — used for news/funding/acquisition signals
NEWSAPI_KEY=

# SerpAPI — used for supplemental news/funding search
SERPAPI_KEY=

# Unipile (LinkedIn) — OAuth connect, connection sync, send messages/requests
UNIPILE_API_KEY=
UNIPILE_DSN=
UNIPILE_WEBHOOK_SECRET=

# Resend (Email) — outbound email delivery
RESEND_API_KEY=

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# App
APP_URL=http://localhost:8000
ENVIRONMENT=development
